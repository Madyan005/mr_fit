# =====================================================================
#  MR-Fit 2.0 - environment template
#  Copy to `.env` (same folder as docker-compose.yml) and fill in values.
#  `.env` is gitignored. Never commit real values.
# =====================================================================

# ---------- Compose profiles ----------
# gpu   : Ollama with NVIDIA GPU reservation (needs NVIDIA Container Toolkit / Docker Desktop WSL2 GPU)
# cpu   : Ollama on CPU (no GPU needed; slow but works)
# tools : pgAdmin on http://127.0.0.1:5050
# Leave empty and set LLM_BACKEND=fake to run with no Ollama at all.
COMPOSE_PROFILES=gpu

# ---------- App ----------
APP_ENV=dev
# REQUIRED. At least 32 chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated browser origins allowed by CORS. The Flutter app is a native
# client and does not need CORS; leave empty unless a browser client is used.
CORS_ORIGINS=
# Where the API is published on the host. 0.0.0.0 lets a phone on the same LAN reach it.
API_HOST_BIND=0.0.0.0
API_HOST_PORT=8000
AI_COOLDOWN_SECONDS=10

# ---------- PostgreSQL + TimescaleDB ----------
POSTGRES_USER=mrfit
# REQUIRED. Use URL-safe characters only (letters, digits, - _), e.g. secrets.token_hex(24)
POSTGRES_PASSWORD=
POSTGRES_DB=mrfit
POSTGRES_HOST_PORT=5432
# Only needed when running the API outside Docker (e.g. uvicorn on the host):
# DATABASE_URL=postgresql+psycopg://mrfit:<password>@127.0.0.1:5432/mrfit

# Time-series policies (days)
TS_COMPRESS_AFTER_DAYS=7
TS_SENSOR_RETENTION_DAYS=90
TS_SKELETON_RETENTION_DAYS=30
# Max rows accepted by one POST /sets/{id}/timeseries or /skeleton request
MAX_TIMESERIES_BATCH=5000
MAX_SKELETON_BATCH=1000

# ---------- Coach LLM (local, constrained) ----------
# ollama | fake   (fake = deterministic FakeLLMClient, no GPU/Ollama needed)
LLM_BACKEND=ollama
# Only deepseek-r1:1.5b (Q4_K_M) is allowed; the API refuses to start otherwise.
OLLAMA_MODEL=deepseek-r1:1.5b
# How long Ollama keeps the model in VRAM after a request. "0" = unload immediately.
OLLAMA_KEEP_ALIVE=0
OLLAMA_TIMEOUT_SECONDS=120

# ---------- Optional: Gemini natural-language parsing (Magic Input) ----------
# Off by default. When true, GEMINI_API_KEY is required and the google-genai
# package is installed into the API image at build time.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Optional: pgAdmin (profile "tools") ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
