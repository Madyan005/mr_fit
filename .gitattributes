# Shell scripts run inside Linux containers; CRLF line endings break them.
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Contracts are compared byte-for-byte by tests and read by both Python and Dart.
*.json text eol=lf
*.dart text eol=lf
*.ini text eol=lf
